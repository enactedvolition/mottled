{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/enactedvolition/mottled/main/docs/schema/mottled-trajectory-1.schema.json",
  "title": "mottled-trajectory/1",
  "description": "Manifest of a kind:\"trajectory\" .mtj container: one StateTrajectory at full fidelity (docs/mtj-format.md). A stream is several containers back to back. Unknown fields are allowed and must be ignored by readers.",
  "type": "object",
  "required": [
    "format",
    "version",
    "kind",
    "tokens",
    "arrays"
  ],
  "properties": {
    "format": {
      "const": "mottled-trajectory",
      "description": "the container family (both kinds share it)"
    },
    "schema": {
      "const": "mottled-trajectory/1",
      "description": "this schema's id; absent in files written before schema ids existed"
    },
    "version": {
      "const": 1
    },
    "kind": {
      "const": "trajectory"
    },
    "meta": {
      "type": "object"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "arrays": {
      "$ref": "#/$defs/arrays"
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vocab": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topk": {
      "$ref": "#/$defs/topk"
    },
    "inspector": {
      "$ref": "#/$defs/inspector"
    }
  },
  "$defs": {
    "arrayRef": {
      "type": "object",
      "description": "where one typed array lives in the blob",
      "required": [
        "dtype",
        "shape",
        "offset",
        "length"
      ],
      "properties": {
        "dtype": {
          "type": "string",
          "description": "float16 | float32 | int32; readers skip arrays of a dtype they do not know"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "byte offset from the start of the blob; a multiple of 16"
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "description": "byte length = product(shape) x item size"
        }
      }
    },
    "arrays": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/arrayRef"
      }
    },
    "topk": {
      "type": "array",
      "description": "[layer][token][rank] = [token, probability]",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": [
                  "number",
                  "null"
                ]
              }
            ]
          }
        }
      }
    },
    "inspector": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "idx": {
          "type": "string",
          "minLength": 1,
          "x-mtj-array": true,
          "description": "name of an entry in `arrays`"
        },
        "sim": {
          "type": "string",
          "minLength": 1,
          "x-mtj-array": true,
          "description": "name of an entry in `arrays`"
        },
        "component_shares": {
          "type": "string",
          "minLength": 1,
          "x-mtj-array": true,
          "description": "name of an entry in `arrays`"
        }
      }
    },
    "analysis": {
      "type": "object",
      "description": "the analysis record (provenance.record): what produced the file",
      "required": [
        "schema",
        "created",
        "mottled",
        "config"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^mottled-analysis/[0-9]+$"
        },
        "created": {
          "type": "string"
        },
        "mottled": {
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "type": "object"
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
